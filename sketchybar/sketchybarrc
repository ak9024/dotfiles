#!/usr/bin/env bash

# sketchybar runs with a minimal PATH; plugins need brew binaries (aerospace, etc)
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

# Plugins cache values that are static at runtime but not across a reload — the
# workspace list follows persistent-workspaces in aerospace.toml, the Wi-Fi
# device follows the hardware. A reload is the one moment both can have changed.
rm -f "${TMPDIR:-/tmp}/sketchybar_aerospace_workspaces" \
      "${TMPDIR:-/tmp}/sketchybar_wifi_device"

FONT="Hack Nerd Font"

##### BAR #####
sketchybar --bar \
  height=32 \
  blur_radius=30 \
  position=top \
  sticky=on \
  padding_left=8 \
  padding_right=8 \
  color="$BAR_COLOR" \
  border_width=0 \
  corner_radius=0 \
  shadow=on

##### DEFAULTS #####
sketchybar --default \
  updates=when_shown \
  icon.font="$FONT:Bold:15.0" \
  icon.color="$WHITE" \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.font="$FONT:Semibold:13.0" \
  label.color="$WHITE" \
  label.padding_left=4 \
  label.padding_right=8 \
  background.corner_radius=6 \
  background.height=24 \
  background.drawing=off \
  padding_left=2 \
  padding_right=2

##### AEROSPACE WORKSPACES (left) #####
sketchybar --add event aerospace_workspace_change

# The items are inert: no script, no subscription. One watcher below paints all
# of them, so an app switch costs a fixed two AeroSpace queries instead of one
# per workspace.
for sid in $(aerospace list-workspaces --all); do
  sketchybar --add item space."$sid" left \
    --set space."$sid" \
      icon="$sid" \
      icon.font="$FONT:Bold:14.0" \
      icon.padding_left=9 \
      icon.padding_right=9 \
      label.drawing=off \
      drawing=off \
      click_script="aerospace workspace $sid"
done

# Hidden, so updates=on is required — a when_shown item never runs its script.
# Window closes have no AeroSpace hook; aerospace.toml's on-focus-changed
# triggers aerospace_workspace_change to catch the common case (closing the
# focused window moves focus). The 5s timer remains the backstop for windows
# closed without a focus change (background app quits its own window).
sketchybar --add item space_watcher left \
  --subscribe space_watcher aerospace_workspace_change front_app_switched \
                            system_woke display_change \
  --set space_watcher \
    drawing=off \
    updates=on \
    update_freq=5 \
    script="$PLUGIN_DIR/aerospace.sh"

##### FRONT APP (left) #####
sketchybar --add item front_app left \
  --subscribe front_app front_app_switched system_woke display_change \
  --set front_app \
    icon.drawing=off \
    label.font="$FONT:Heavy:13.0" \
    label.color="$ACCENT_COLOR" \
    padding_left=12 \
    script="$PLUGIN_DIR/front_app.sh"

##### RIGHT SIDE #####
# Added right-to-left: clock ends up rightmost.
sketchybar --add item clock right \
  --subscribe clock system_woke \
  --set clock \
    icon="󰥔" \
    icon.color="$MAGENTA" \
    update_freq=15 \
    script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
  --subscribe battery power_source_change system_woke \
  --set battery \
    update_freq=60 \
    script="$PLUGIN_DIR/battery.sh"

sketchybar --add item wifi right \
  --subscribe wifi wifi_change system_woke \
  --set wifi \
    update_freq=30 \
    script="$PLUGIN_DIR/wifi.sh"

sketchybar --add item network right \
  --subscribe network wifi_change system_woke \
  --set network \
    update_freq=2 \
    script="$PLUGIN_DIR/network.sh"

sketchybar --add item volume right \
  --subscribe volume volume_change \
  --set volume \
    script="$PLUGIN_DIR/volume.sh"

sketchybar --add item disk right \
  --subscribe disk system_woke \
  --set disk \
    update_freq=300 \
    script="$PLUGIN_DIR/disk.sh"

sketchybar --add item cpu right \
  --set cpu \
    update_freq=5 \
    script="$PLUGIN_DIR/cpu.sh"

# Group the status readouts under one background so they read as a single block
# against the bare workspace numbers on the left.
sketchybar --add bracket status cpu disk volume network wifi battery clock \
  --set status \
    background.drawing=on \
    background.color="$ITEM_BG_COLOR" \
    background.corner_radius=6 \
    background.height=26

##### FINALIZE #####
sketchybar --hotload on
sketchybar --update
